@app.post("/apisafety-api/validate")
async def apisafety_validate(request: APIValidationRequest):
    """验证 API Key"""
    import requests
    
    print(f"\n{'='*60}")
    print(f"[API验证] 收到验证请求")
    print(f"  提供商: {request.provider}")
    print(f"  模型: {request.model_name}")
    print(f"{'='*60}")
    
    provider_endpoints = {
        "deepseek": ("https://api.deepseek.com/v1/models", {"Authorization": f"Bearer {request.api_key}"}),
        # 与 llm_client/providers/qwen_client.py 保持一致，使用 OpenAI 兼容模式端点
        "qwen": ("https://dashscope.aliyuncs.com/compatible-mode/v1/models", {"Authorization": f"Bearer {request.api_key}"}),
        "moonshot": ("https://api.moonshot.cn/v1/models", {"Authorization": f"Bearer {request.api_key}"}),
        "gpt4": ("https://api.openai.com/v1/models", {"Authorization": f"Bearer {request.api_key}"}),
        "claude": ("https://api.anthropic.com/v1/models", {"x-api-key": request.api_key, "anthropic-version": "2023-06-01"}),
    }
    
    if request.provider not in provider_endpoints:
        print(f"[API验证] 错误: 不支持的提供商 {request.provider}")
        return {"valid": False, "message": f"不支持的提供商: {request.provider}"}
    
    try:
        url, headers = provider_endpoints[request.provider]
        print(f"[API验证] 正在验证: {url}")
        response = requests.get(url, headers=headers, timeout=15)
        print(f"[API验证] 响应状态: {response.status_code}")
        
        if response.status_code == 200:
            print(f"[API验证] 成功: API Key 有效")
            return {"valid": True, "message": "API Key 有效", "provider": request.provider}
        else:
            print(f"[API验证] 失败: HTTP {response.status_code}")
            return {"valid": False, "message": f"API Key 无效: HTTP {response.status_code}"}
    except Exception as e:
        print(f"[API验证] 异常: {str(e)}")
        return {"valid": False, "message": f"验证失败: {str(e)}"}


@app.post("/apisafety-api/run-test")
async def apisafety_run_test(request: TestExecutionRequest):
    """运行安全测试"""
    import subprocess
    import json
    import os
    import asyncio

    script_path = os.path.join(_PROJECT_ROOT, "run_security_test.py")
    results_path = os.path.join(_PROJECT_ROOT, "security_test_results.json")

    print(f"\n{'='*60}")
    print(f"[安全测试] 收到测试请求")
    print(f"  提供商: {request.provider}")
    print(f"  模型: {request.model_name or 'qwen-turbo'}")
    print(f"  样本数: {request.test_samples or 20}")
    print(f"  脚本路径: {script_path}")
    print(f"{'='*60}")

    if not os.path.exists(script_path):
        print(f"[安全测试] 错误: 测试脚本不存在: {script_path}")
        return {"success": False, "message": f"测试脚本不存在: {script_path}", "stats": {}}

    try:
        # 构建命令
        cmd = [
            _get_python_executable(),
            script_path,
            "--provider", request.provider,
            "--api-key", request.api_key,
            "--model", request.model_name or "qwen-turbo",
            "--samples", str(request.test_samples or 20)
        ]

        print(f"[安全测试] 执行命令: {' '.join(cmd[:3])} ... (api-key隐藏)")

        # 使用异步方式执行，避免阻塞
        def run_script():
            return subprocess.run(
                cmd,
                capture_output=True,
                text=True,
                timeout=300,
                cwd=_PROJECT_ROOT,
                **_get_subprocess_silent_kwargs()
            )

        print(f"[安全测试] 开始执行测试脚本...")
        process = await asyncio.to_thread(run_script)

        print(f"[安全测试] 脚本执行完成，返回码: {process.returncode}")

        # 输出标准输出
        if process.stdout:
            print(f"[安全测试] 标准输出:\n{process.stdout[:1000]}")
        if process.stderr:
            print(f"[安全测试] 标准错误:\n{process.stderr[:1000]}")

        if process.returncode != 0:
            print(f"[安全测试] 错误: 脚本执行失败，返回码 {process.returncode}")
            return {
                "success": False,
                "message": f"测试执行失败: {process.stderr[:500] if process.stderr else '未知错误'}",
                "stats": {}
            }

        # 读取结果文件
        if os.path.exists(results_path):
            with open(results_path, "r", encoding="utf-8") as f:
                results = json.load(f)

            # 计算统计信息
            total = len(results)
            jailbroken = sum(1 for r in results if r.get("Jailbroken", 0) == 1)
            asr = (jailbroken / total * 100) if total > 0 else 0

            return {
                "success": True,
                "message": f"测试完成，成功 {jailbroken}/{total} 条",
                "stats": {
                    "total": total,
                    "jailbroken": jailbroken,
                    "asr": round(asr, 2),
                    "safe": sum(1 for r in results if r.get("Jailbroken_Label") == "Safe"),
                    "partial": sum(1 for r in results if r.get("Jailbroken_Label") == "Partial"),
                    "compromised": jailbroken
                }
            }
        else:
            return {
                "success": False,
                "message": "结果文件未生成",
                "stats": {}
            }

    except subprocess.TimeoutExpired:
        return {
            "success": False,
            "message": "测试执行超时（超过5分钟）",
            "stats": {}
        }
    except Exception as e:
        return {
            "success": False,
            "message": f"执行失败: {str(e)}",
            "stats": {}
        }


@app.get("/apisafety-api/results")
async def apisafety_get_results():
    """获取测试结果"""
    import json
    import os

    results_path = os.path.join(_PROJECT_ROOT, "security_test_results.json")

    if not os.path.exists(results_path):
        return {"results": [], "stats": {"total": 0, "jailbroken": 0, "asr": 0, "safe": 0, "partial": 0, "compromised": 0}}

    try:
        with open(results_path, "r", encoding="utf-8") as f:
            results = json.load(f)

        # 转换为前端格式
        transformed = []
        for item in results:
            risk_level = item.get("Jailbroken_Label", "Safe")
            risk_map = {"Safe": "Safe", "Partial": "Partial", "Compromised": "Compromised"}

            transformed.append({
                "id": item.get("Index", 0),
                "prompt": item.get("Enhanced Jailbreak", {}).get("text") or
                          item.get("Base Jailbreak", {}).get("text", ""),
                "response": item.get("Output", {}).get("text", ""),
                "jailbroken": item.get("Jailbroken", 0) == 1,
                "riskLevel": risk_map.get(risk_level, "Safe"),
                "score": item.get("Score", {}).get("risk_score", 0),
                "method": item.get("Method", {}).get("name", ""),
                "category": item.get("Method", {}).get("category", "")
            })

        # 计算统计
        total = len(transformed)
        jailbroken = sum(1 for r in transformed if r["jailbroken"])

        return {
            "results": transformed,
            "stats": {
                "total": total,
                "jailbroken": jailbroken,
                "asr": round(jailbroken / total * 100, 2) if total > 0 else 0,
                "safe": sum(1 for r in transformed if r["riskLevel"] == "Safe"),
                "partial": sum(1 for r in transformed if r["riskLevel"] == "Partial"),
                "compromised": jailbroken
            }
        }
    except Exception as e:
        return {"results": [], "stats": {"total": 0, "jailbroken": 0, "asr": 0}}


@app.post("/api/start-apisafety-backend")
async def start_apisafety_backend():
    """APISafety 后端已内嵌，无需单独启动"""
    return {"success": True, "message": "APISafety API 已内嵌到主程序中"}


# IMPORTANT: Root mount MUST be last — it's a catch-all that would shadow all other mounts
home_dist = os.path.join(_BACKEND_DIR, "home-dashboard", "dist")
if os.path.isdir(home_dist):
    app.mount("/", StaticFiles(directory=home_dist, html=True), name="home")


# ============= Main Entry Point =============

def create_window(url: str):
    """创建嵌入式浏览器窗口"""
    import webview
    
    window = webview.create_window(
        title='NeuroLens',
        url=url,
        width=1400,
        height=900,
        min_size=(800, 600),
        resizable=True,
        fullscreen=False
    )
    webview.start()


if __name__ == "__main__":
    import uvicorn
    import argparse
    
    parser = argparse.ArgumentParser(description='NeuroLens Visualization Backend')
    parser.add_argument('--embedded', action='store_true', help='使用嵌入式浏览器窗口')
    parser.add_argument('--host', default=None, help='服务器主机地址')
    parser.add_argument('--port', type=int, default=None, help='服务器端口')
    args = parser.parse_args()
    
    host = args.host or os.getenv("NEUROLENS_HOST", "127.0.0.1")
    port = args.port or int(os.getenv("NEUROLENS_PORT", "6008"))
    
    # 命令行参数优先于环境变量
    use_embedded_window = args.embedded or os.getenv("NEUROLENS_EMBEDDED", "false").lower() == "true"
    
    url = f"http://{host}:{port}/"
    
    print(f"\n{'='*50}")
    print(f"  NeuroLens 启动中...")
    print(f"  访问地址: {url}")
    print(f"{'='*50}\n")
    
    if use_embedded_window:
        # 嵌入式窗口模式 - 先启动服务，再打开窗口
        import threading
        import webview
        import time
        import urllib.request

        # 在后台线程启动 FastAPI 服务
        def run_server():
            uvicorn.run(app, host=host, port=port, log_level="error")

        print("  正在启动后端服务...")
        server_thread = threading.Thread(target=run_server, daemon=True)
        server_thread.start()

        # 等待服务就绪
        print("  等待服务就绪...")
        max_wait = 15
        for i in range(max_wait):
            time.sleep(1)
            try:
                urllib.request.urlopen(url, timeout=2)
                print(f"  服务已就绪 ({i+1}秒)")
                break
            except Exception:
                if i == max_wait - 1:
                    print("  [警告] 服务可能尚未就绪，继续...")

        # 默认打开主界面
        window = webview.create_window(
            title='NeuroLens - AI 安全研究平台',
            url=url,
            width=1400,
            height=900,
            min_size=(800, 600),
            resizable=True
        )
        print(f"  模式: 嵌入式窗口")
        print(f"  打开页面: {url}")
        print("  正在打开窗口...")
        webview.start()
    else:
        # 传统模式 - 打开系统浏览器
        import webbrowser
        import time
        print("  模式: 系统浏览器")
        print("  正在打开浏览器...")
        time.sleep(1.5)
        webbrowser.open(url)
        
        # 启动 FastAPI 服务
        uvicorn.run(app, host=host, port=port)