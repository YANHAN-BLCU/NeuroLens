"""
NeuroLens Visualization Backend
FastAPI server for serving visualization data
"""

import subprocess
import threading
import uuid as _uuid
from fastapi import FastAPI, Query, HTTPException, Request
from fastapi.responses import FileResponse, JSONResponse, Response
from fastapi.staticfiles import StaticFiles
from fastapi.middleware.cors import CORSMiddleware
import httpx
import urllib.request
from pydantic import BaseModel
from typing import List, Optional, Dict, Any
import json
import os
import sys
from datetime import datetime


def _get_subprocess_silent_kwargs() -> Dict[str, Any]:
    """在 Windows 下隐藏子进程控制台窗口；其他系统不处理。"""
    if os.name == "nt":
        return {"creationflags": subprocess.CREATE_NO_WINDOW}
    return {}


def read_version_from_repo_root(repo_root: str) -> str:
    """读取仓库根目录 VERSION 首行；失败时抛出异常。"""
    # 尝试多个可能的路径（源码模式 / 打包冻结模式）
    candidates = [
        os.path.join(repo_root, "VERSION"),
        os.path.join(repo_root, "_internal", "VERSION"),
    ]
    for p in candidates:
        try:
            with open(p, "r", encoding="utf-8") as f:
                line = (f.readline() or "").strip()
                if line:
                    return line
        except OSError:
            pass
    raise RuntimeError(
        "无法读取版本号：请确保 VERSION 文件存在且首行非空。"
    )


def _resolve_runtime_paths() -> tuple[str, str]:
    """
    Resolve (project_root, backend_dir) for both source and PyInstaller runtime.

    Frozen mode (COLLECT/onedir):
      - sys.executable is at <install_dir>/NeuroLens.exe
      - Data files are at <install_dir>/_internal/
      - We need to use executable's directory, NOT _MEIPASS
    """
    if getattr(sys, "frozen", False):
        # executable's directory is the app root (contains NeuroLens.exe and _internal/)
        executable_dir = os.path.dirname(sys.executable)
        # Data files are in the _internal subdirectory
        backend_dir = os.path.join(executable_dir, "_internal")
        return os.path.normpath(executable_dir), os.path.normpath(backend_dir)

    backend_dir = os.path.dirname(__file__)
    project_root = os.path.normpath(os.path.join(backend_dir, "..", ".."))
    return project_root, os.path.normpath(backend_dir)


def _get_python_executable() -> str:
    """
    获取 Python 可执行文件路径。优先级：
    1. 项目内 env/Scripts/python.exe（APISafety 依赖环境）
    2. 系统 PATH 中的 python
    3. 当前 sys.executable（源码开发模式）

    用于在 subprocess 中执行 run_security_test.py 等脚本。
    """
    # 优先使用项目内 env 虚拟环境（安装程序配置）
    env_python = os.path.normpath(os.path.join(_PROJECT_ROOT, "env", "Scripts", "python.exe"))
    if os.path.isfile(env_python):
        return env_python

    # 回退：尝试系统 PATH
    try:
        result = subprocess.run(
            ["python", "--version"],
            capture_output=True,
            timeout=2,
            **_get_subprocess_silent_kwargs()
        )
        if result.returncode == 0:
            return "python"
    except Exception:
        pass

    # 最后回退：当前解释器（源码开发模式）
    return sys.executable


_PROJECT_ROOT, _BACKEND_DIR = _resolve_runtime_paths()
# 版本号只由仓库根目录 VERSION 文件决定，避免环境变量覆盖导致版本不一致。
NEUROLENS_VERSION = read_version_from_repo_root(_PROJECT_ROOT)

# Initialize FastAPI app
app = FastAPI(
    title="NeuroLens Visualization API",
    description="Backend API for NeuroLens visualization system",
    version=NEUROLENS_VERSION,
)

# Configure CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

