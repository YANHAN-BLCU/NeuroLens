# Constants
def _resolve_data_root() -> str:
    """Resolve outputs directory: env var > app_config.json > default relative path."""
    env_val = os.getenv("NEUROLENS_OUTPUTS_DIR")
    if env_val and os.path.isdir(env_val):
        return env_val

    config_path = os.path.normpath(
        os.path.join(_PROJECT_ROOT, "configs", "runtime", "app_config.json")
    )
    try:
        if os.path.exists(config_path):
            with open(config_path, "r", encoding="utf-8") as f:
                cfg = json.load(f)
            outputs_dir = cfg.get("outputs_dir", "")
            if outputs_dir and os.path.isdir(outputs_dir):
                return outputs_dir
    except Exception:
        pass

    return os.path.normpath(os.path.join(_PROJECT_ROOT, "outputs"))

DATA_ROOT = _resolve_data_root()
AVAILABLE_LAYERS = [0, 5, 10, 15, 20, 25, 30, 31]

# Mount outputs directory so panel fetch('../outputs/...') requests resolve to real data.
if os.path.isdir(DATA_ROOT):
    app.mount("/outputs", StaticFiles(directory=DATA_ROOT), name="outputs")

# ============= Pydantic Models =============

class PipelineConfig(BaseModel):
    model: str
    attack_types: List[str]
    threshold: float
    finetune_method: str = "none"

class InterventionRequest(BaseModel):
    neuron_ids: List[str]
    sample_ids: List[str]

class FinetuneRequest(BaseModel):
    method: str
    config: Dict[str, Any]

# ============= Helper Functions =============

def load_json_file(filepath: str) -> Dict[str, Any]:
    """Load JSON file from outputs directory"""
    full_path = os.path.join(DATA_ROOT, filepath)
    if not os.path.exists(full_path):
        return {}
    try:
        with open(full_path, 'r', encoding='utf-8') as f:
            return json.load(f)
    except UnicodeDecodeError:
        # Try with latin-1 encoding as fallback
        try:
            with open(full_path, 'r', encoding='latin-1') as f:
                return json.load(f)
        except Exception as e:
            print(f"Error loading {filepath} with latin-1: {e}")
            return {}
    except Exception as e:
        print(f"Error loading {filepath}: {e}")
        return {}

