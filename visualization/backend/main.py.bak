# ============= Panel F/G/H APIs =============

@app.get("/api/layer_similarity")
async def get_layer_similarity():
    """
    Panel F: Layer-to-layer cosine similarity matrix.
    Computed from mean hidden states per layer in the probe cache.
    """
    import numpy as np

    npz_path = os.path.join(DATA_ROOT, "probes", "llama-3-8b", "hidden_states_cache.npz")
    if not os.path.exists(npz_path):
        return {"error": "hidden_states_cache.npz not found"}

    try:
        data = np.load(npz_path, allow_pickle=True)
        # shape: (samples, num_layers, hidden_dim)
        hs = data["train_hs"].astype(np.float32)
        num_layers = hs.shape[1]

        # mean representation per layer
        layer_means = hs.mean(axis=0)  # (num_layers, hidden_dim)

        # cosine similarity matrix
        norms = np.linalg.norm(layer_means, axis=1, keepdims=True)
        norms = np.where(norms == 0, 1e-8, norms)
        normed = layer_means / norms
        sim_matrix = (normed @ normed.T).tolist()

        labels = [f"L{i}" for i in range(num_layers)]
        return {"matrix": sim_matrix, "layer_labels": labels}
    except Exception as e:
        return {"error": str(e)}


@app.get("/api/attack_paths")
async def get_attack_paths():
    """
    Panel G: Sankey diagram — attack source → neuron quadrant → jailbreak outcome.
    Derived from base_evaluation.jsonl (attack source + jailbreak verdict).
    Quadrant counts come from quadrant_classification.json.
    """
    jsonl_path = os.path.join(DATA_ROOT, "base_evaluation.jsonl")
    quad_path = os.path.join(DATA_ROOT, "quadrant_classification", "quadrant_classification.json")

    if not os.path.exists(jsonl_path):
        return {"error": "base_evaluation.jsonl not found"}

    # --- load evaluation records ---
    records = []
    try:
        with open(jsonl_path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    records.append(json.loads(line))
    except Exception as e:
        return {"error": str(e)}

    # --- aggregate attack source × outcome ---
    # Normalise source names to the 4 attack families shown in the panel
    SOURCE_MAP = {
        "GPTFuzzer": "GPTFuzz",
        "GPTFuzz": "GPTFuzz",
        "Do Anything Now": "AutoDAN",
        "AutoDAN": "AutoDAN",
        "GPT-Gen": "GCG",
        "Advbench": "GCG",
        "HH-red-team": "PAIR",
        "HH-harmless": "PAIR",
        "Multilingual": "PAIR",
        "ToxicChat": "GCG",
        "Do-Not-Answer": "GCG",
    }
    ATTACKS = ["GCG", "AutoDAN", "PAIR", "GPTFuzz"]
    QUADRANTS = ["S+A+", "S-A-", "S+A-", "S-A+"]

    # attack → quadrant counts (use quadrant distribution as proxy)
    quad_data = {}
    if os.path.exists(quad_path):
        try:
            quad_data = json.load(open(quad_path, encoding="utf-8"))
        except Exception:
            pass

    quad_counts = {q: 0 for q in QUADRANTS}
    for v in quad_data.values():
        q = v.get("quadrant", "")
        if q in quad_counts:
            quad_counts[q] += 1
    total_quad = sum(quad_counts.values()) or 1

    # Count per-attack jailbreak + refused from evaluation log
    attack_total: dict[str, int] = {a: 0 for a in ATTACKS}
    attack_jb: dict[str, int] = {a: 0 for a in ATTACKS}

    for rec in records:
        orig = rec.get("input", {}).get("original_sample", {})
        raw_src = orig.get("source", "")
        attack = SOURCE_MAP.get(raw_src)
        if attack is None:
            continue
        attack_total[attack] += 1
        if rec.get("guard", {}).get("jailbreak_success"):
            attack_jb[attack] += 1

    # Build attack → quadrant links (distribute proportionally by quadrant frequency)
    links = []
    for attack in ATTACKS:
        total = attack_total[attack]
        if total == 0:
            continue
        for q in QUADRANTS:
            val = round(total * quad_counts[q] / total_quad)
            if val > 0:
                links.append({"source": attack, "target": q, "value": val})

    # Build quadrant → outcome links
    quad_jb: dict[str, int] = {q: 0 for q in QUADRANTS}
    quad_ref: dict[str, int] = {q: 0 for q in QUADRANTS}
    for attack in ATTACKS:
        total = attack_total[attack]
        jb = attack_jb[attack]
        ref = total - jb
        if total == 0:
            continue
        for q in QUADRANTS:
            share = quad_counts[q] / total_quad
            quad_jb[q] += round(jb * share)
            quad_ref[q] += round(ref * share)

    for q in QUADRANTS:
        if quad_jb[q] > 0:
            links.append({"source": q, "target": "Jailbroken", "value": quad_jb[q]})
        if quad_ref[q] > 0:
            links.append({"source": q, "target": "Refused", "value": quad_ref[q]})

    nodes = (
        [{"id": a, "label": a, "type": "attack"} for a in ATTACKS]
        + [{"id": q, "label": f"{q}", "type": "quadrant"} for q in QUADRANTS]
        + [{"id": "Jailbroken", "label": "Jailbroken", "type": "output"},
           {"id": "Refused",   "label": "Refused",    "type": "output"}]
    )

    return {"nodes": nodes, "links": links}


@app.get("/api/neuron_activations")
async def get_neuron_activations(
    successful: bool = True,
    failed: bool = True,
):
    """
    Panel H: Violin plot of activation values grouped by neuron quadrant.
    Each quadrant entry contains lists of successful_mean and failed_mean values
    from quadrant_classification.json.
    """
    quad_path = os.path.join(DATA_ROOT, "quadrant_classification", "quadrant_classification.json")
    if not os.path.exists(quad_path):
        return {"error": "quadrant_classification.json not found"}

    try:
        quad_data = json.load(open(quad_path, encoding="utf-8"))
    except Exception as e:
        return {"error": str(e)}

    QUADRANTS = ["S+A+", "S-A-", "S+A-", "S-A+"]
    result: dict[str, dict] = {q: {"successful": [], "failed": []} for q in QUADRANTS}

    for v in quad_data.values():
        q = v.get("quadrant", "")
        if q not in result:
            continue
        if successful:
            val = v.get("successful_mean")
            if val is not None:
                result[q]["successful"].append(round(float(val), 6))
        if failed:
            val = v.get("failed_mean")
            if val is not None:
                result[q]["failed"].append(round(float(val), 6))

    return result


# ============= Task Runner (subprocess-based) =============

def _resolve_script_path(relative_script: str) -> str:
    """
    Resolve script path under project root and validate existence.
    """
    script_path = os.path.normpath(os.path.join(_PROJECT_ROOT, relative_script))
    if not os.path.isfile(script_path):
        raise FileNotFoundError(f"Script not found: {script_path}")
    return script_path


_tasks: Dict[str, Dict] = {}  # task_id -> {status, log, proc}

def _run_task(task_id: str, cmd: list, cwd: str):
    """Run a subprocess task and stream output into _tasks[task_id]['log']."""
    entry = _tasks[task_id]
    entry["status"] = "running"
    try:
        proc = subprocess.Popen(
            cmd, cwd=cwd,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
            **_get_subprocess_silent_kwargs()
        )
        entry["proc"] = proc
        for line in proc.stdout:
            entry["log"].append(line.rstrip())
        proc.wait()
        entry["returncode"] = proc.returncode
        entry["status"] = "completed" if proc.returncode == 0 else "failed"
    except Exception as e:
        entry["log"].append(f"[error] {e}")
        entry["status"] = "failed"


class FinetuneRunRequest(BaseModel):
    model_path: str
    evaluation_log: str
    safety_neurons: str
    output: str
    num_epochs: int = 3
    batch_size: int = 4
    learning_rate: float = 5e-5
    save_only_delta: bool = True
    bf16: bool = True


class PipelineRunRequest(BaseModel):
    model_path: str
    salad_data: str = "data/salad"
    alpaca_data: str = "data/alpaca/alpaca_data.jsonl"
    output: str = "outputs/neurobreak_pipeline"
    from_phase: int = 0
    safety_threshold_q: float = 0.005
    utility_threshold_p: float = 0.01
    num_epochs: int = 3
    bf16: bool = True


class ASRRunRequest(BaseModel):
    model_path: str
    classifier_path: str
    output: str = "outputs/asr_results.jsonl"
    max_samples: Optional[int] = None


@app.post("/api/tasks/finetune")
async def task_finetune(req: FinetuneRunRequest):
    task_id = str(_uuid.uuid4())
    script_path = _resolve_script_path(_PROJECT_ROOT + "/scripts/finetuning/run_tsft_finetuning.py")
    cmd = [
        _get_python_executable(), script_path,
        "--model-path", req.model_path,
        "--evaluation-log", req.evaluation_log,
        "--safety-neurons", req.safety_neurons,
        "--output", req.output,
        "--num-epochs", str(req.num_epochs),
        "--batch-size", str(req.batch_size),
        "--learning-rate", str(req.learning_rate),
        "--save-only-delta", str(req.save_only_delta),
    ]
    if req.bf16:
        cmd.append("--bf16")
    _tasks[task_id] = {"status": "pending", "log": [], "proc": None, "type": "finetune"}
    t = threading.Thread(target=_run_task, args=(task_id, cmd, _PROJECT_ROOT), daemon=True)
    t.start()
    return {"task_id": task_id, "status": "pending"}


